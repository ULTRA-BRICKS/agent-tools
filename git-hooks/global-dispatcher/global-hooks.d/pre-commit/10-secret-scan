#!/bin/sh
# global-hook-id: secret-scan
# global-hook-protected: true
# secret-scan — global tiered gitleaks gate over the STAGED changes.
#
# CAPABILITY ID: `secret-scan` (declared above). A repo that already runs a secret
# scan locally lists this id in its .githooks-skip (or `git config hooks.skipGlobal
# secret-scan`) so the dispatcher does NOT run this fragment there too — see the DEDUP
# section in run-global-hooks. install-local-hooks.sh writes that entry automatically.
#
# PROTECTED (`global-hook-protected: true`): this is a SECURITY gate, so a .githooks-skip
# shipped by a CLONED repo cannot silently disable it — the dispatcher honors the file for
# this id only when you opt in via GIT CONFIG `git config --global hooks.trustSkipFile true`
# (env is NOT trusted for protected ids — a repo's lefthook `env:` could inject it). Your
# git config hooks.skipGlobal always disables it. The retrofit writes ONLY the .githooks-skip
# file (it does NOT auto-write a trusted git config), so this scan is never disabled silently
# — you opt in explicitly (git config) to dedup it.
#
# Invoked by the composing pre-commit hook (./pre-commit). Standalone & testable:
#   git diff --cached must be non-empty for it to do anything.
#
# TIERS
#   BLOCK pass: high-confidence provider rules (gitleaks default ruleset + the global
#               block config). A hit => exit 1 (commit aborted), naming file + rule.
#   WARN  pass: fuzzy heuristics (high-entropy strings, secret-looking var names with no
#               provider match). A hit => printed to stderr, but exit 0 (commit ALLOWED).
#
# CONFIG / EXTENSIBILITY (precedence handled here, mirrors `gitleaks --help`):
#   - per-repo  $REPO/.gitleaks.toml      -> if present, used for the BLOCK pass (it may
#                                            [extend].path the global config to inherit it).
#   - global    ~/.config/gitleaks/gitleaks.toml       -> BLOCK tier (default when no repo file)
#   - global    ~/.config/gitleaks/gitleaks-warn.toml  -> WARN tier (always the global one)
#
# ESCAPE HATCH for false positives (also printed in the block message):
#   1. inline:  add a `gitleaks:allow` comment on the offending line.
#   2. global:  add a regex/path to [allowlist] in ~/.config/gitleaks/gitleaks.toml
#   3. per-repo: add an [allowlist] to the repo's .gitleaks.toml
#   (last resort, discouraged: git commit --no-verify bypasses ALL gates.)

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -z "$(git diff --cached --name-only)" ] && exit 0

# gitleaks not installed -> warn loudly but do not block (the gate degrades gracefully;
# CI is the backstop). Install: brew install gitleaks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "secret-scan: gitleaks not installed — skipping secret scan (install: brew install gitleaks)." >&2
  exit 0
fi

GL_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/gitleaks"
BLOCK_CFG="$GL_DIR/gitleaks.toml"
WARN_CFG="$GL_DIR/gitleaks-warn.toml"

# --- BLOCK pass -------------------------------------------------------------------
# Per-repo .gitleaks.toml wins for the block tier; else the global block config.
block_cfg=""
if [ -f "$ROOT/.gitleaks.toml" ]; then
  block_cfg="$ROOT/.gitleaks.toml"
elif [ -f "$BLOCK_CFG" ]; then
  block_cfg="$BLOCK_CFG"
fi

set --
[ -n "$block_cfg" ] && set -- -c "$block_cfg"

# -v finding blocks go to STDOUT, log lines to STDERR — capture both into the temp file.
if ! gitleaks git --staged --redact --no-banner -v --no-color "$@" >/tmp/.secret-scan-block.$$ 2>&1; then
  echo "" >&2
  echo "secret-scan: BLOCKED — a high-confidence secret was found in the staged changes." >&2
  echo "------------------------------------------------------------------------" >&2
  # -v prints "Finding:/RuleID:/File:/Line:" blocks; surface those, drop INF/WRN log noise.
  grep -E '^(Finding|RuleID|File|Line|Fingerprint):' /tmp/.secret-scan-block.$$ | sed 's/^/  /' >&2
  echo "------------------------------------------------------------------------" >&2
  echo "  Fix: remove the secret; move it to env / a secret manager; rotate it if it ever left your machine." >&2
  echo "  False positive? ESCAPE HATCH (pick one):" >&2
  echo "    1. inline   : add a 'gitleaks:allow' comment on that line" >&2
  echo "    2. global   : add a regex/path to [allowlist] in $BLOCK_CFG" >&2
  echo "    3. per-repo : add an [allowlist] to $ROOT/.gitleaks.toml" >&2
  echo "  (last resort: git commit --no-verify bypasses ALL pre-commit gates)" >&2
  rm -f /tmp/.secret-scan-block.$$
  exit 1
fi
rm -f /tmp/.secret-scan-block.$$

# --- WARN pass (never blocks) -----------------------------------------------------
# Only runs if the global warn config exists. Surfaces fuzzy/suspicious cases.
if [ -f "$WARN_CFG" ]; then
  if ! gitleaks git --staged --redact --no-banner -v --no-color -c "$WARN_CFG" >/tmp/.secret-scan-warn.$$ 2>&1; then
    echo "" >&2
    echo "secret-scan: WARNING — suspicious string(s) in the staged changes (NOT blocking)." >&2
    echo "  Review these; if they are real secrets, do NOT commit. If benign, ignore or allowlist." >&2
    grep -E '^(Finding|RuleID|File|Line):' /tmp/.secret-scan-warn.$$ | sed 's/^/  /' >&2
  fi
  rm -f /tmp/.secret-scan-warn.$$
fi

exit 0
