#!/bin/sh
# global-hook-id: protect-main
# global-hook-protected: true
# protect-main — block DIRECT pushes to main/master, except the first root commit to an empty remote.
#
# WHY: GitHub branch protection is a paid feature on private free-plan repos (the API
# returns 403), so the server cannot reject a push to main. This client-side pre-push
# gate is the enforcement after bootstrap: land changes via a PR (gh ship), never a direct push.
# An entirely empty remote has no branch from which a PR can be opened, so one root commit may
# create main/master. Once ANY remote ref exists, normal PR-only enforcement applies.
#
# Refs arrive on stdin, one line per ref: "<local-ref> <local-sha> <remote-ref> <remote-sha>".
# Non-main refs and branch DELETIONS (local sha = all zeros) pass untouched — this gate
# targets CODE pushes; deleting the DEFAULT branch is already refused server-side by
# git/GitHub on every plan (receive.denyDeleteCurrent / "refusing to delete the current
# branch"), and deleting a protected NON-default branch (a master that is not the
# default) is deliberately out of scope.
#
# PROTECTED: a cloned repo's .githooks-skip / env cannot silently disable this gate
# (see run-global-hooks DEDUP/TRUST). Your own `git config hooks.skipGlobal protect-main`
# still can — you set that, a repo can't.
#
# ESCAPE HATCH (honest + audited): release scripts that legitimately push main run
#   PUSH_MAIN_OK=1 PUSH_MAIN_REASON="why" git push ...
# Every use is APPENDED to ~/.cache/agent-tools/overrides.log — auditable, never silent.

ZEROS=0000000000000000000000000000000000000000
remote_target="${2:-$1}"
remote_checked=0
remote_empty=0

is_root_commit() {
  line="$(git rev-list --parents -n 1 "$1" 2>/dev/null)" || return 1
  [ -n "$line" ] || return 1
  case "$line" in
    *" "*) return 1 ;;
    *) return 0 ;;
  esac
}

remote_is_empty() {
  if [ "$remote_checked" -eq 0 ]; then
    remote_checked=1
    refs="$(git ls-remote "$remote_target" 2>/dev/null)" || return 1
    [ -z "$refs" ] && remote_empty=1
  fi
  [ "$remote_empty" -eq 1 ]
}

blocked=""
# `|| [ -n "$remote_ref" ]` — paranoia against fail-open: process a final line even if
# it somehow lacks the trailing newline (git always sends one; belt and braces).
while read -r _local_ref local_sha remote_ref remote_sha || [ -n "$remote_ref" ]; do
  [ -n "$remote_ref" ] || continue
  case "$remote_ref" in refs/heads/main|refs/heads/master) ;; *) continue ;; esac
  case "$local_sha" in "$ZEROS"*) continue ;; esac  # deletion, not a code push

  # Bootstrap exception: a PR cannot exist before an empty repository has its first branch.
  # Allow exactly one root commit to create main/master, and only when the remote has NO refs.
  # Any ambiguity (non-root history, another remote ref, or ls-remote failure) stays blocked.
  case "$remote_sha" in
    ""|*[!0]*) ;;
    *)
      if is_root_commit "$local_sha" && remote_is_empty; then
        echo "protect-main: bootstrap — allowing first root commit to $remote_ref on an empty remote" >&2
        continue
      fi
      ;;
  esac

  blocked="$blocked $remote_ref"   # accumulate — a push may hit main AND master
done
blocked="${blocked# }"

[ -n "$blocked" ] || exit 0

if [ "${PUSH_MAIN_OK:-}" = "1" ]; then
  log_dir="${XDG_CACHE_HOME:-$HOME/.cache}/agent-tools"
  mkdir -p "$log_dir" 2>/dev/null || true
  repo="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  total=0; failed=0
  for ref in $blocked; do    # one audit line PER protected ref (refs contain no spaces)
    total=$((total + 1))
    printf '%s protect-main OVERRIDE repo=%s ref=%s reason=%s\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$repo" \
      "$ref" "${PUSH_MAIN_REASON:-<none>}" >> "$log_dir/overrides.log" 2>/dev/null || failed=$((failed + 1))
  done
  if [ "$failed" -eq 0 ]; then
    echo "protect-main: PUSH_MAIN_OK=1 — allowing push to $blocked (logged to $log_dir/overrides.log)" >&2
  else
    # Never CLAIM an audit line that was not written; the push is still allowed (a
    # read-only cache must not break releases), but the miss is loud, not silent —
    # and the count stays honest when only SOME of several refs got logged.
    echo "protect-main: PUSH_MAIN_OK=1 — allowing push to $blocked" >&2
    echo "protect-main: WARNING — could NOT append to $log_dir/overrides.log; $failed of $total override line(s) are UNAUDITED." >&2
  fi
  exit 0
fi

echo "" >&2
echo "protect-main: BLOCKED — direct push to $blocked." >&2
echo "  Land it via a PR instead:" >&2
echo "    git push origin HEAD:refs/heads/<feature-branch>" >&2
echo "    Open a PR on this repository's forge; merge through the guarded flow (fj ship or gh ship)." >&2
echo "  Legit exception (e.g. a release script)?" >&2
echo "    PUSH_MAIN_OK=1 PUSH_MAIN_REASON=\"why\" git push ..." >&2
echo "  Every override is appended to ~/.cache/agent-tools/overrides.log." >&2
exit 1
