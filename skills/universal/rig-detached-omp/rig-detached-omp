#!/usr/bin/env bash
# rig-detached-omp — the canonical rig-owned detached-agent launcher for omp (oh-my-pi).
# Carrier: this file ships as the `rig-detached-omp` UNIVERSAL SKILL
# (skills/universal/rig-detached-omp/). rig copies the whole skill dir to
# ~/.agents/skills/rig-detached-omp/ (default skills_target, default-on via
# skills.universal.all) — mirroring rig-detached-opencode exactly — so the
# provisioned command on a rig-managed machine is
# ~/.agents/skills/rig-detached-omp/rig-detached-omp
# and the gate REMINDERs name exactly that path. `bin/` is NOT a rig-discovered
# carrier: a launcher placed there would not exist on a provisioned machine.
#
# Usage: rig-detached-omp <name> <brief-file> [workdir] [model]
#
# Launches a DETACHED `omp -p` (non-interactive, process-and-exit) session carrying
# the subagent identity markers RIG_AGENT_ID=<name> and RIG_DETACHED_AGENT=1. The omp
# hook bridge (lib/omp_hook_bridge/dispatch.py) injects args.agent_id from those markers
# on every tool call (`_detached_agent_id`, agent-tools#573), so every agents-hooks/v1
# delegation gate (orchestrator-stays-thin, background-subagent-gate,
# no-long-inline-process, subagent-no-bg-longproc) classifies the child session as a
# dispatched subagent instead of the orchestrator.
#
# NOTE: omp's own `task` tool ALREADY dispatches as a background AsyncJobManager job by
# omp's own contract (docs/tools/task.md) — for a dispatch happening FROM INSIDE a running
# omp session, `task` itself is usually the right tool and needs no launcher at all. This
# script exists for the narrower case `task` cannot cover: a truly detached process that
# outlives the calling session, or delegated work started outside any omp session's `task`
# call in the first place.
#
# Why the process env is the sanctioned identity source: a running orchestrator
# cannot retroactively mutate its own process environment — it can only set
# these vars for a CHILD process, which is exactly the sanctioned act of
# dispatching a subagent. Model-controlled tool args can never self-exempt (the
# bridge strips forged agent_id keys before the env injection).
#
# Conventions:
#   - <brief-file> is a UTF-8 markdown brief: the mission, acceptance criteria,
#     and the HANDOFF FILE PATH the child must write before exiting (the
#     orchestrator polls that file to collect the result).
#   - stdout/stderr of the child append to $RIG_AGENT_LOG_DIR/<name>.log
#     (default /tmp/agent-logs; dir 0700 + owner-checked, log 0600, symlink refused).
#   - The launcher RETURNS immediately (child is nohup-detached): dispatching
#     must not block the calling shell — that is the whole point of detaching.
#   - The child runs `omp -p --auto-approve --no-session --cwd <workdir>` (plus
#     `--model <model>` when the optional 4th arg is given): -p/--print for
#     non-interactive process-and-exit, --auto-approve because a detached background
#     process has no human present to approve tool calls, --no-session since the
#     handoff file named in the brief is the real result contract (not the omp session
#     log), and --model to pin the child to a specific logged-in model/provider/account
#     (fuzzy-matched by omp itself, e.g. "opus", "opencode-go/mimo-v2.5") instead of
#     always inheriting the orchestrator's config.yml default — config.yml routing does
#     not hot-reload into already-dispatched sessions (agent-tools#687), so a caller that
#     needs a specific model for this child MUST pass it here, not edit the config.
#
# Minimal by design: no manifest, no registry, no status tracking — the log
# file and the handoff file named in the brief are the contract.

set -euo pipefail

if [ "$#" -lt 2 ] || [ "$#" -gt 4 ]; then
    echo "usage: $0 <name> <brief-file> [workdir] [model]" >&2
    exit 2
fi

name="$1"
brief="$2"
workdir="${3:-$PWD}"
model="${4:-}"

if ! [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo "rig-detached-omp: invalid agent name '$name' (letters, digits, '.', '_', '-' only)" >&2
    exit 2
fi
if [ ! -f "$brief" ] || [ ! -s "$brief" ]; then
    echo "rig-detached-omp: brief file '$brief' missing or empty" >&2
    exit 2
fi
if [ ! -d "$workdir" ]; then
    echo "rig-detached-omp: workdir '$workdir' is not a directory" >&2
    exit 2
fi
# Canonicalize BEFORE the `cd "$workdir"` below: the child also receives this same string
# via `--cwd "$workdir"`, and a RELATIVE workdir would otherwise be resolved a SECOND time
# against the already-cd'd directory (`./packages/app` from `/repo` becomes
# `/repo/packages/app/packages/app` for the child, or a silent wrong-tree run if that
# nested path happens to exist) — the same GH-497 P1 class the brief-read-before-cd
# comment above already guards against, applied to this second relative-path use.
# `CDPATH=''` matches this repo's own canonicalize idiom (`canon_dir` in
# git-hooks/global-dispatcher/install-local-hooks.sh): an inherited CDPATH makes bash's
# `cd` print the resolved path to stdout on a match, which would corrupt this command
# substitution with a second line. `--` stops a workdir literally named `-P`/`-L`/`-`
# from being parsed as a `cd` option (e.g. `cd -P` silently landing in $OLDPWD/$HOME).
workdir="$(CDPATH='' cd -- "$workdir" && pwd -P)"
if ! command -v omp >/dev/null 2>&1; then
    echo "rig-detached-omp: 'omp' not found on PATH" >&2
    exit 127
fi

# Log hygiene (ported from rig-detached-opencode, GH-497): the log carries the whole
# brief plus the child's transcript, so it must not be world-readable, and on a shared
# host another account must not be able to pre-plant the directory or a symlink at the
# log path.
umask 077
log_dir="${RIG_AGENT_LOG_DIR:-/tmp/agent-logs}"
mkdir -p "$log_dir"
# Absolute BEFORE the cd below: a relative RIG_AGENT_LOG_DIR would be checked here and
# opened somewhere else after `cd "$workdir"`.
log_dir="$(cd "$log_dir" && pwd -P)"
if [ ! -O "$log_dir" ]; then
    echo "rig-detached-omp: log dir '$log_dir' is not owned by you — refusing (set RIG_AGENT_LOG_DIR)" >&2
    exit 2
fi
chmod 700 "$log_dir"
log="$log_dir/$name.log"
if [ -L "$log" ] || { [ -e "$log" ] && [ ! -f "$log" ]; }; then
    echo "rig-detached-omp: log path '$log' is a symlink or not a regular file — refusing" >&2
    exit 2
fi
# An EXISTING log (a re-launched agent name) may carry a looser mode from before; tighten it
# rather than appending the brief into a world-readable file.
touch "$log" && chmod 600 "$log"

# Read the brief BEFORE changing directory: a RELATIVE <brief-file> is validated
# against the caller's cwd above, and `cd "$workdir"` would make the same path
# resolve somewhere else. Reading it inside the backgrounded command substitution
# below would then fail silently (set -e does not reach into `$(...)` on a
# `nohup ... &` line) and launch omp with an EMPTY prompt while still exiting 0
# (the same GH-497 P1 class rig-detached-opencode's launcher fixed).
brief_text="$(cat -- "$brief")"

cd "$workdir"
export RIG_AGENT_ID="$name"
export RIG_DETACHED_AGENT=1

{
    # Record the requested model in the launch header when given: the log is the ONLY
    # persistent record of this dispatch (--no-session means no omp session log exists
    # as a fallback), and omp's own --model is a fuzzy match — if it silently resolves
    # to the wrong model, or the child dies before flushing any of its own output, this
    # line is the only place "what was actually requested" survives (review finding).
    # Sanitize for the RECORD ONLY: a $model containing \n or other control chars would
    # fork this single header line into forged extra log lines (and a reader taking
    # splitlines()[0] would silently truncate past the fork). The argv path is NOT
    # affected — the unsanitized $model still reaches omp verbatim, one argv word.
    if [ -n "$model" ]; then
        model_log="$(printf '%s' "$model" | tr -d '[:cntrl:]')"
        echo "--- $(date -u '+%Y-%m-%dT%H:%M:%SZ') launching detached agent '$name' in '$workdir' (model '$model_log')"
    else
        echo "--- $(date -u '+%Y-%m-%dT%H:%M:%SZ') launching detached agent '$name' in '$workdir'"
    fi
} >>"$log"

# Detach for real (mirrors rig-detached-opencode's launcher, three parts):
#   * `--` ends option parsing — omp's CLI would otherwise eat a brief starting with
#     `---` (frontmatter) or `- ` (a bullet) as a flag, and the child would start with an
#     EMPTY message while the launcher still exits 0;
#   * `</dev/null` — nohup only redirects stdin when it is a TTY; under a harness bash
#     tool stdin is a pipe, and an interactive-shaped omp read would otherwise block on
#     the caller's pipe;
#   * a NEW SESSION (setsid) — nohup only masks SIGHUP; the child stayed in the caller's
#     process group and a harness that tree-/group-kills its tool call on completion or
#     timeout would kill the "detached" agent with it. macOS ships no `setsid(1)`, so
#     fall back to python3 (a hard dependency of the hook family anyway): os.setsid()
#     then exec. The forked `&` child is never a group leader, so setsid cannot fail.
_new_session() {
    if command -v setsid >/dev/null 2>&1; then
        exec setsid "$@"
    fi
    exec python3 -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' "$@"
}
export -f _new_session

model_args=()
if [ -n "$model" ]; then
    model_args=(--model "$model")
fi

# `${model_args[@]+"${model_args[@]}"}` (not a bare `"${model_args[@]}"`) — an EMPTY
# array under `set -u` on bash < 4.4 (incl. macOS /bin/bash 3.2.57, this script's own
# stock-macOS target per the setsid/python3 fallback above) is the nounset trap: bash
# aborts word expansion with "model_args[@]: unbound variable" on every DEFAULT
# (no-model) invocation, and since that abort happens inside the backgrounded `&`
# subshell, `set -e` never observes it — the launcher still prints "launched" and
# exits 0 while the child never execs (mirrors the guard this repo already uses at
# skills/universal/gh-graphql/ghgql:112 for the same empty-optional-array shape).
nohup bash -c '_new_session "$@"' _ \
    omp -p --auto-approve --no-session --cwd "$workdir" "${model_args[@]+"${model_args[@]}"}" -- "$brief_text" \
    </dev/null >>"$log" 2>&1 &
pid=$!

echo "detached agent '$name' launched (pid $pid, log $log, workdir $workdir)"
exit 0
