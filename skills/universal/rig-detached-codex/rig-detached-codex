#!/usr/bin/env bash
# rig-detached-codex — the canonical rig-owned detached-agent launcher for Codex CLI.
# Carrier: this file ships as the `rig-detached-codex` UNIVERSAL SKILL
# (skills/universal/rig-detached-codex/). rig copies the whole skill dir to
# ~/.agents/skills/rig-detached-codex/ (default skills_target, default-on via
# skills.universal.all) — mirroring rig-detached-opencode exactly — so the
# provisioned command on a rig-managed machine is
# ~/.agents/skills/rig-detached-codex/rig-detached-codex
# and the gate REMINDERs name exactly that path. `bin/` is NOT a rig-discovered
# carrier: a launcher placed there would not exist on a provisioned machine.
#
# Usage: rig-detached-codex <name> <brief-file> [workdir]
#
# Launches a DETACHED `codex exec` session carrying the subagent identity
# markers RIG_AGENT_ID=<name> and RIG_DETACHED_AGENT=1. The codex hook bridge
# (lib/codex_hook_bridge/dispatch.py) injects args.agent_id from those markers
# on every hook invocation (`_detached_agent_id`, agent-tools#573), so every
# agents-hooks/v1 delegation gate (orchestrator-stays-thin, background-subagent-gate,
# no-long-inline-process, subagent-no-bg-longproc) classifies the child session as a
# dispatched subagent instead of the orchestrator.
#
# Why the process env is the sanctioned identity source: a running orchestrator
# cannot retroactively mutate its own process environment — it can only set
# these vars for a CHILD process, which is exactly the sanctioned act of
# dispatching a subagent. Model-controlled tool args can never self-exempt (the
# bridge strips forged agent_id keys before the env injection).
#
# Conventions:
#   - <brief-file> is a UTF-8 markdown brief: the mission, acceptance criteria,
#     and the HANDOFF FILE PATH the child must write before exiting (the
#     orchestrator polls that file to collect the result).
#   - stdout/stderr of the child append to $RIG_AGENT_LOG_DIR/<name>.log
#     (default /tmp/agent-logs; dir 0700 + owner-checked, log 0600, symlink refused).
#   - The launcher RETURNS immediately (child is nohup-detached): dispatching
#     must not block the calling shell — that is the whole point of detaching.
#   - The child runs `codex exec --sandbox workspace-write --skip-git-repo-check`:
#     workspace-write so the dispatched agent can actually write/run what its brief
#     asks (a read-only sandbox silently fails every write), and
#     --skip-git-repo-check so a throwaway/scratch workdir that isn't a git repo yet
#     doesn't abort the launch.
#
# Minimal by design: no manifest, no registry, no status tracking — the log
# file and the handoff file named in the brief are the contract.

set -euo pipefail

if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
    echo "usage: $0 <name> <brief-file> [workdir]" >&2
    exit 2
fi

name="$1"
brief="$2"
workdir="${3:-$PWD}"

if ! [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo "rig-detached-codex: invalid agent name '$name' (letters, digits, '.', '_', '-' only)" >&2
    exit 2
fi
if [ ! -f "$brief" ] || [ ! -s "$brief" ]; then
    echo "rig-detached-codex: brief file '$brief' missing or empty" >&2
    exit 2
fi
if [ ! -d "$workdir" ]; then
    echo "rig-detached-codex: workdir '$workdir' is not a directory" >&2
    exit 2
fi
# Canonicalize BEFORE the `cd "$workdir"` below: the child also receives this same string
# via `-C "$workdir"`, and a RELATIVE workdir would otherwise be resolved a SECOND time
# against the already-cd'd directory (`./packages/app` from `/repo` becomes
# `/repo/packages/app/packages/app` for the child, or a silent wrong-tree run if that
# nested path happens to exist) — the same GH-497 P1 class the brief-read-before-cd
# comment above already guards against, applied to this second relative-path use.
# `CDPATH=''` matches this repo's own canonicalize idiom (`canon_dir` in
# git-hooks/global-dispatcher/install-local-hooks.sh): an inherited CDPATH makes bash's
# `cd` print the resolved path to stdout on a match, which would corrupt this command
# substitution with a second line. `--` stops a workdir literally named `-P`/`-L`/`-`
# from being parsed as a `cd` option (e.g. `cd -P` silently landing in $OLDPWD/$HOME).
workdir="$(CDPATH='' cd -- "$workdir" && pwd -P)"
if ! command -v codex >/dev/null 2>&1; then
    echo "rig-detached-codex: 'codex' not found on PATH" >&2
    exit 127
fi

# Log hygiene (ported from rig-detached-opencode, GH-497): the log carries the whole
# brief plus the child's transcript, so it must not be world-readable, and on a shared
# host another account must not be able to pre-plant the directory or a symlink at the
# log path.
umask 077
log_dir="${RIG_AGENT_LOG_DIR:-/tmp/agent-logs}"
mkdir -p "$log_dir"
# Absolute BEFORE the cd below: a relative RIG_AGENT_LOG_DIR would be checked here and
# opened somewhere else after `cd "$workdir"`.
log_dir="$(cd "$log_dir" && pwd -P)"
if [ ! -O "$log_dir" ]; then
    echo "rig-detached-codex: log dir '$log_dir' is not owned by you — refusing (set RIG_AGENT_LOG_DIR)" >&2
    exit 2
fi
chmod 700 "$log_dir"
log="$log_dir/$name.log"
if [ -L "$log" ] || { [ -e "$log" ] && [ ! -f "$log" ]; }; then
    echo "rig-detached-codex: log path '$log' is a symlink or not a regular file — refusing" >&2
    exit 2
fi
# An EXISTING log (a re-launched agent name) may carry a looser mode from before; tighten it
# rather than appending the brief into a world-readable file.
touch "$log" && chmod 600 "$log"

# Read the brief BEFORE changing directory: a RELATIVE <brief-file> is validated
# against the caller's cwd above, and `cd "$workdir"` would make the same path
# resolve somewhere else. Reading it inside the backgrounded command substitution
# below would then fail silently (set -e does not reach into `$(...)` on a
# `nohup ... &` line) and launch codex with an EMPTY prompt while still exiting 0
# (the same GH-497 P1 class rig-detached-opencode's launcher fixed).
brief_text="$(cat -- "$brief")"

cd "$workdir"
export RIG_AGENT_ID="$name"
export RIG_DETACHED_AGENT=1
# Hand the caller's forum topic to the child (agent-tools#848): the nohup-detached child is
# reparented to pid 1, so `tg` cannot tie its calls (nor those of tools that shell out to it,
# e.g. the task-cli `[task created]` notifier) to this session and they would post to General.
# `tg --session-topic` (tg-cli#553) prints this session's topic id, or nothing; ask it HERE,
# before detaching, and export only a numeric answer from a SUCCESSFUL call — no session, no
# `tg`, a failing or older `tg` (usage text instead of an id) sets nothing and leaves the launch
# unaffected (a TG_TOPIC the caller itself already exports passes through untouched). `</dev/null`
# so the lookup never reads the caller's harness pipe.
if tg_topic="$(tg --session-topic </dev/null 2>/dev/null)" && [[ "$tg_topic" =~ ^[0-9]+$ ]]; then
    export TG_TOPIC="$tg_topic"
fi

{
    echo "--- $(date -u '+%Y-%m-%dT%H:%M:%SZ') launching detached agent '$name' in '$workdir'"
} >>"$log"

# Detach for real (mirrors rig-detached-opencode's launcher, three parts):
#   * `--` ends option parsing — codex's CLI (clap) would otherwise eat a brief starting
#     with `---` (frontmatter) or `- ` (a bullet) as a flag, and the child would start
#     with an EMPTY prompt while the launcher still exits 0;
#   * `</dev/null` — a documented codex bug (openai/codex#20919): `codex exec "<prompt>"`
#     hangs indefinitely on a non-TTY stdin pipe with no writer even though the prompt was
#     given as a positional argument; under a harness bash tool stdin is exactly such a
#     pipe, so the child would hang forever without this redirect;
#   * a NEW SESSION (setsid) — nohup only masks SIGHUP; the child stayed in the caller's
#     process group and a harness that tree-/group-kills its tool call on completion or
#     timeout would kill the "detached" agent with it. macOS ships no `setsid(1)`, so
#     fall back to python3 (a hard dependency of the hook family anyway): os.setsid()
#     then exec. The forked `&` child is never a group leader, so setsid cannot fail.
_new_session() {
    if command -v setsid >/dev/null 2>&1; then
        exec setsid "$@"
    fi
    exec python3 -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' "$@"
}
export -f _new_session
nohup bash -c '_new_session "$@"' _ \
    codex exec --sandbox workspace-write --skip-git-repo-check -C "$workdir" -- "$brief_text" \
    </dev/null >>"$log" 2>&1 &
pid=$!

echo "detached agent '$name' launched (pid $pid, log $log, workdir $workdir)"
exit 0
