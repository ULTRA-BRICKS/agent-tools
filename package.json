{
  "name": "agent-tools",
  "private": true,
  "description": "Repo-local Oxc toolchain so Rig can provision anti-slop + oxlint.config.ts.",
  "type": "module",
  "scripts": {
    "lint": "oxlint --disable-nested-config oxlint.config.ts",
    "lint:all": "oxlint --type-aware --disable-nested-config --ignore-pattern 'vendor/**' --ignore-pattern 'tools/oxlint/anti-slop/**'",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.json",
    "test": "uv run --with pytest pytest tests/"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.82.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.9.2"
  }
}
